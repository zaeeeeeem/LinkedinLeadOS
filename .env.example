# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# The values below are the local Docker stack's. `supabase start` prints the keys;
# `supabase status -o env` prints them again at any time. They are not secret — the
# local stack ships with fixed demo keys — but .env is still gitignored, because the
# same file is where a hosted project's real keys would go.
#
# Ports are the 553xx block, not Supabase's default 543xx: two other local Supabase
# projects on this machine already hold 543xx and 563xx (D90).

# PostgREST endpoint, used by the store client.
SUPABASE_URL=http://127.0.0.1:55321

# The store client writes with the service role: RLS is on with no policies and the
# only grants are to service_role, so the anon key reaches nothing (D91).
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection. This is the path D4 means by "the agent runs SQL
# directly" — psql against this URL, not a wrapper capability.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
