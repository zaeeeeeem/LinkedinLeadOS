node_modules
node_modules/
# Anchored to the repo root on purpose. Unanchored, `fixtures/` also matched
# `src/core/fixtures/` — the promoter and field-map modules — which were
# therefore never committed at all, leaving `scripts/promote-fixtures.ts`
# importing files a fresh clone does not have. The captured-data directories
# these exist to keep out of git are both at the root.
/runs/
/runs
/fixtures/
# The operator's own correspondence never reaches the shared fixture library
# (D118) and never reaches git either. D327: capabilities built for private
# surfaces name this root explicitly; absence of that naming stays refusal.
/.fixtures-private/
.env
.env.local
dist/
.supabase/

# Supabase local state (also covered by supabase/.gitignore)
supabase/.branches/
supabase/.temp/
.DS_Store
